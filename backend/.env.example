# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sanxuanyi

# Auth
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
JWT_SECRET=change-this-secret-key
JWT_EXPIRE_HOURS=24

# App file cache
# Note: this is *server-side* local disk cache used when users download app versions.
APP_FILE_CACHE_DIR=/tmp/sanxuanyi-app-cache
APP_FILE_CACHE_MAX_SIZE_MB=1024
