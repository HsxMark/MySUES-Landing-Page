# 三旋翼课程表 - 前端静态兜底配置（无后端时生效）
#
# 拷贝为 .env.local 后按需修改。以下默认值使「下载区」在后端不可用时仍完整展示。
# 若你部署了 FastAPI 后端（完整版），可忽略本文件，下载区将由后端动态提供。
#
# Android 下载地址（APK 直链 或 GitHub Releases 页）
NEXT_PUBLIC_ANDROID_URL=https://github.com/HsxMark/MySUES/releases/latest
# Android 展示版本号
NEXT_PUBLIC_ANDROID_VERSION=1.0.0
# Android 展示文件名
NEXT_PUBLIC_ANDROID_FILENAME=sanxuanyi.apk
# Android 文件大小（字节），不知道可留空显示 "0 MB"
NEXT_PUBLIC_ANDROID_SIZE=0
